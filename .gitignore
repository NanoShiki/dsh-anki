# Public repository allow-list. Never add workspace collections, credentials,
# local dependency installs, test fixtures, logs, exports or release archives.
/*
!/.gitignore
!/.gitattributes
!/ACCEPTANCE.md
!/ANKI-LICENSE.txt
!/LICENSE
!/README.md
!/THIRD-PARTY-NOTICES.md
!/VERIFICATION.md
!/auto-sync.js
!/client.js
!/cordis.patch.yml
!/icon.svg
!/index.js
!/package.json
!/runtime-sha256.json
!/worker-client.js
!/CONTRIBUTING.md

# Repository policy and CI, nothing else.
!/.github/
/.github/*
!/.github/pull_request_template.md

!/backend/
/backend/*
!/backend/*.py

!/locale/
/locale/*
!/locale/en.json
!/locale/zh.json

!/scripts/
/scripts/*
!/scripts/setup_runtime.py
!/scripts/setup_core.py

# Official headless wheels: full file set pinned by core-sha256.json.
!/core/
!/core-lock.json
!/core-sha256.json
!/third-party-licenses/
/core/**/__pycache__/
/core/**/*.pyc

# Official, redistributable CPython files pinned by runtime-sha256.json.
!/runtime/
/runtime/*
!/runtime/_asyncio.pyd
!/runtime/_bz2.pyd
!/runtime/_ctypes.pyd
!/runtime/_decimal.pyd
!/runtime/_elementtree.pyd
!/runtime/_hashlib.pyd
!/runtime/_lzma.pyd
!/runtime/_multiprocessing.pyd
!/runtime/_overlapped.pyd
!/runtime/_queue.pyd
!/runtime/_socket.pyd
!/runtime/_sqlite3.pyd
!/runtime/_ssl.pyd
!/runtime/_uuid.pyd
!/runtime/_wmi.pyd
!/runtime/_zoneinfo.pyd
!/runtime/libcrypto-3.dll
!/runtime/libffi-8.dll
!/runtime/libssl-3.dll
!/runtime/LICENSE.txt
!/runtime/pyexpat.pyd
!/runtime/python.cat
!/runtime/python.exe
!/runtime/python3.dll
!/runtime/python313._pth
!/runtime/python313.dll
!/runtime/python313.zip
!/runtime/pythonw.exe
!/runtime/select.pyd
!/runtime/sqlite3.dll
!/runtime/unicodedata.pyd
!/runtime/vcruntime140_1.dll
!/runtime/vcruntime140.dll
!/runtime/winsound.pyd

# Only test source; every fixture directory and generated artifact is excluded.
!/tests/
/tests/*
!/tests/*.py
!/tests/*.mjs
